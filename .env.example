# EQSANS CLI Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Configuration (for LLM features)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_FALLBACK_MODEL=google/gemini-3-flash-preview

# Optional: Override base URL (default: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Default output directory
# EQSANS_OUTPUT_DIR=./output/

# Optional: Default IPTS (for quick access)
# EQSANS_DEFAULT_IPTS=35520
